# Source-only local repository. Existing runtime and evidence remain on disk.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/打开工作台.cmd
!/AGENTS.md
!/PRD.md
!/ARCHITECTURE.md
!/IMPLEMENTATION_PLAN.md
!/docs/
/docs/**
!/docs/**/
!/docs/**/*.md
!/rules/
/rules/**
!/rules/**/
!/rules/**/*.md
!/app/
/app/*
!/app/.gitignore
!/app/README.md
!/app/package.json
!/app/package-lock.json
!/app/tsconfig.json
!/app/tsconfig.server.json
!/app/vite.config.ts
!/app/vitest.config.ts
!/app/playwright.config.ts
!/app/Start-Studio.ps1
!/app/Stop-Studio.ps1
!/app/src/
!/app/tests/
!/app/scripts/
/app/scripts/*
!/app/scripts/backup.ts
!/app/scripts/diagnose.ts
!/app/scripts/restore.ts
!/app/scripts/open-studio.mjs
!/app/scripts/native-dsh-interaction.mjs
!/app/scripts/test-server.ts
!/app/scripts/dsh-workspace.ps1
!/app/scripts/source-audit.mjs
!/app/docs/
!/app/docs/**
# Defense in depth, including under otherwise allowed source directories.
**/node_modules/
**/dist/
**/runtime/
**/.codex/
**/.dsh/
**/.credentials*
**/.env
**/.env.*
**/auth.json
**/*.sqlite*
**/*.db
**/*.db-*
**/*.log
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/backups/
**/test-results/
**/playwright-report/
**/.DS_Store

/archive/
/app/workspaces/
**/credentials/
